# Use a long, random value. Never commit the real .env file.
BANK_ADMIN_KEY=replace_with_a_long_random_admin_key
BANK_SESSION_SECRET=replace_with_an_independent_random_session_secret

# Optional overrides. The defaults are certs/localhost.pem and certs/localhost-key.pem.
# BANK_SSL_CERT=/absolute/path/to/localhost.pem
# BANK_SSL_KEY=/absolute/path/to/localhost-key.pem
